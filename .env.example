# Local database
DATABASE_URL=sqlite+aiosqlite:///./backend/dev.db
DATABASE_URL_SYNC=sqlite:///./backend/dev.db

# JWT 密钥，部署时必须修改为随机字符串
SECRET_KEY=replace-with-a-long-random-secret

# 调试模式，生产环境设为 false
APP_DEBUG=false

# 允许访问 API 的前端来源，多个来源用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# APP_DEBUG=true 时可用于初始化开发账号；生产环境不要使用弱密码
# SEED_ADMIN_PASSWORD=admin123
# SEED_LIHE_PASSWORD=123456
# SEED_SONGYINGLUN_PASSWORD=123456
